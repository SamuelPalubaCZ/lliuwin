#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
export WINEPREFIX="$root/wine" WINEARCH=win32 WINEDEBUG=-all
mkdir -p "$root/build/downloads"
installer="$root/build/downloads/python-2.7.18.msi"
if [[ ! -f $WINEPREFIX/drive_c/Python27/python.exe ]]; then
    curl --fail --location --retry 3 --proto '=https' --proto-redir '=https' https://www.python.org/ftp/python/2.7.18/python-2.7.18.msi -o "$installer"
    echo "d901802e90026e9bad76b8a81f8dd7e43c7d7e8269d9281c9e9df7a9c40480a9  $installer" | sha256sum -c -
    wineboot --init
    wine msiexec /i "$(winepath -w "$installer")" /qn ALLUSERS=1 TARGETDIR=C:\\Python27
    wineserver -w
fi
wine C:/Python27/python.exe -c 'import sys; assert sys.version_info[:3] == (2,7,18)'
